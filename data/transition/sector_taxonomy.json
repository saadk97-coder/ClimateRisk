  "_meta": {
    "description": "Sector taxonomy for transition risk layer. Aggregated from GICS industries, NACE Rev. 2, and EXIOBASE-3 sector list. Each sector keys into pass-through, learning-curve, IO matrix and CCExposure tables.",
    "sources": [
      "GICS classification system (S&P/MSCI 2023)",
      "NACE Rev. 2 (Eurostat)",
      "EXIOBASE-3 sector list (Stadler et al. 2018, https://doi.org/10.1111/jiec.12715)"
    ],
    "version": "v1 — Session 8",
    "field_notes": {
      "emission_intensity_t_per_revenue": "DIRECT (Scope-1) emission intensity, tCO2 per MILLION USD of sector GROSS OUTPUT (EEIO/EXIOBASE-3-informed sector averages). Used ONLY by Layer 3 to build the sector-typical carbon price shock (fraction of output = EI x 1e-6 x carbon_price x pass_through), which is clamped to <=1.0 for the linear propagation basis. Fossil sectors are O(1000s); services O(10s). Screening approximation.",
      "io_index": "Position in the io_matrix.json A matrix (0-indexed, must match _meta.sector_order).",
      "stranding_slope": "R7 — per-sector logistic stranding slope (default 0.20 if absent). Higher = faster impairment diffusion once the L2 crossover triggers, calibrated to asset turnover speed."
    }
  },
